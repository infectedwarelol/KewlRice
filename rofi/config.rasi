configuration {
    modi:            "window";
    show-icons:      true;
    window-format:   "{c}   {t}";
    kb-row-down:     "Alt+Tab,Down";
    kb-row-up:       "Alt+ISO_Left_Tab,Up";
    kb-accept-entry: "Return,KP_Enter";
    kb-cancel:       "Escape";
    me-select-entry: "";
    me-accept-entry: "MousePrimary,Alt+MousePrimary";
}

* {
    bg:                          rgba(43, 58, 74, 0.7);
    fg:                          #e6edf3;
    sel:                         rgba(74, 99, 128, 0.8);
    font:                        "Noto Sans 10";
    background-color:            transparent;
    text-color:                  @fg;
    border-color:                transparent;
    separatorcolor:              transparent;
    background:                  transparent;
    foreground:                  @fg;
    lightbg:                     transparent;
    lightfg:                     @fg;
    blue:                        #8fb8de;
    red:                         #ff6b6b;
    normal-background:           transparent;
    normal-foreground:           @fg;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @fg;
    selected-normal-background:  @sel;
    selected-normal-foreground:  #ffffff;
    active-background:           transparent;
    active-foreground:           #8fb8de;
    alternate-active-background: transparent;
    alternate-active-foreground: #8fb8de;
    selected-active-background:  @sel;
    selected-active-foreground:  #ffffff;
    urgent-background:           transparent;
    urgent-foreground:           #ff6b6b;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: #ff6b6b;
    selected-urgent-background:  @sel;
    selected-urgent-foreground:  #ffffff;
}

window {
    location:         center;
    width:            960px;
    height:           432px;
    padding:          6px;
    background-color: @bg;
    border:           0;
    border-radius:    10px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  6px;
}

inputbar {
    children:         [ entry ];
    margin:           6px 6px 0 6px;
    padding:          6px 8px;
    border-radius:    6px;
    background-color: rgba(255, 255, 255, 0.08);
}

entry {
    placeholder: "";
}

listview {
    border:       0;
    margin:       0 6px 6px 6px;
    fixed-height: false;
    scrollbar:    false;
    spacing:      0;
}

element {
    padding:       4px;
    border-radius: 6px;
    spacing:       8px;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @sel;
    text-color:       #ffffff;
}

element-icon {
    size: 16px;
}

element-text {
    padding:        4px;
    text-color:     inherit;
    vertical-align: 0.5;
}
