{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "modules-left": [
        "custom/logo",
        "group/controls",
        "group/media"
    ],
    "modules-center": [
        "group/datetime"
    ],
    "modules-right": [
        "wlr/taskbar",
        "group/status"
    ],
    "group/controls": {
        "orientation": "horizontal",
        "modules": [
            "custom/control",
            "pulseaudio",
            "custom/media-previous",
            "custom/media-play",
            "custom/media-next"
        ]
    },
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "tray",
            "idle_inhibitor",
            "network",
            "cpu",
            "custom/memory",
            "temperature",
            "custom/device-battery",
            "custom/power"
        ]
    },
    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "image#album-art",
            "custom/now-playing"
        ]
    },
    "image#album-art": {
        "exec": "~/.config/waybar/album-art.sh",
        "size": 26,
        "interval": 3,
        "on-click": "~/.config/hypr/popups/popup_request.py player"
    },
    "custom/now-playing": {
        "exec": "~/.config/waybar/now-playing.sh",
        "return-type": "json",
        "escape": false,
        "on-click": "~/.config/hypr/popups/popup_request.py player"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 26,
        "icon-theme": "WhiteSur",
        "spacing": 6,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": ["waybar"]
    },
    "group/datetime": {
        "orientation": "horizontal",
        "modules": [
            "clock",
            "custom/weather"
        ]
    },
    "custom/logo": {
        "format": "",
        "align": 0.5,
        "justify": "center",
        "tooltip-format": "App launcher",
        "on-click": "~/.config/hypr/launcher.sh"
    },
    "custom/control": {
        "format": "󰒓",
        "tooltip-format": "Control center",
        "on-click": "~/.config/hypr/control-center/control_center.py"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "Volume {volume}%",
        "scroll-step": 5,
        "on-click": "pkill -x pavucontrol || pavucontrol -t 1",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/media-previous": {
        "format": "󰒮",
        "tooltip": false,
        "on-click": "playerctl previous"
    },
    "custom/media-play": {
        "exec": "bash ~/.config/waybar/media-status.sh",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "Playing": "󰏤",
            "Paused": "󰐊",
            "Stopped": "󰐊"
        },
        "on-click": "playerctl play-pause"
    },
    "custom/media-next": {
        "format": "󰒭",
        "tooltip": false,
        "on-click": "playerctl next"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 8
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Staying awake",
        "tooltip-format-deactivated": "Sleep allowed"
    },
    "network": {
        "format-ethernet": "󰈀",
        "format-wifi": "󰖩",
        "format-disconnected": "󰖪",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "tooltip-format-wifi": "{essid}  {signalStrength}%",
        "tooltip-format-disconnected": "Offline"
    },
    "cpu": {
        "interval": 5,
        "format": "󰻠 {usage}%",
        "tooltip": false
    },
    "custom/memory": {
        "exec": "~/.config/waybar/memory.sh",
        "return-type": "json",
        "interval": 3,
        "format": "󰍛 {}"
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "interval": 5,
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}°"
    },
    "custom/device-battery": {
        "exec": "bash ~/.config/waybar/device-battery.sh",
        "return-type": "json",
        "interval": 60,
        "format": "{icon} {text}",
        "format-icons": {
            "headset": "󰁹",
            "mouse": "󰍽",
            "keyboard": "󰌌",
            "default": "󰂄"
        }
    },
    "clock": {
        "interval": 1,
        "on-click": "~/.config/hypr/popups/popup_request.py calendar",
        "format": "<span weight='bold' size='11pt'>{0:%H:%M:%S}</span>\n<span size='7.5pt' fgalpha='70%'>{0:%A, %B %d}</span>",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/weather": {
        "exec": "~/.config/waybar/weather.py",
        "return-type": "json",
        "interval": 900
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Power menu",
        "on-click": "~/.config/hypr/power-menu/power_menu.py"
    }
}
